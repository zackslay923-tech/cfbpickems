{
    "hosting":  [
                    {
                        "target":  "default",
                        "public":  "web/dist",
                        "ignore":  [
                                       "firebase.json",
                                       "**/.*",
                                       "**/node_modules/**"
                                   ],
                        "rewrites":  [
                                         {
                                             "source":  "**",
                                             "destination":  "/index.html"
                                         }
                                     ],
                        "headers":  [
                                        {
                                            "source":  "**",
                                            "headers":  [
                                                            { "key":  "Cache-Control", "value":  "no-cache, no-store, must-revalidate" }
                                                        ]
                                        },
                                        {
                                            "source":  "/assets/**",
                                            "headers":  [
                                                            { "key":  "Cache-Control", "value":  "public, max-age=31536000, immutable" }
                                                        ]
                                        }
                                    ]
                    },
                    {
                        "target":  "cfbpickems",
                        "public":  "web/dist",
                        "ignore":  [
                                       "firebase.json",
                                       "**/.*",
                                       "**/node_modules/**"
                                   ],
                        "rewrites":  [
                                         {
                                             "source":  "**",
                                             "destination":  "/index.html"
                                         }
                                     ],
                        "headers":  [
                                        {
                                            "source":  "**",
                                            "headers":  [
                                                            { "key":  "Cache-Control", "value":  "no-cache, no-store, must-revalidate" }
                                                        ]
                                        },
                                        {
                                            "source":  "/assets/**",
                                            "headers":  [
                                                            { "key":  "Cache-Control", "value":  "public, max-age=31536000, immutable" }
                                                        ]
                                        }
                                    ]
                    }
                ],
    "firestore":  {
                      "rules":  "firestore.rules",
                      "indexes":  "firestore.indexes.json"
                  },
    "functions":  {
                      "source":  "functions"
                  }
}
