rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function submissionsOpen() {
      return !(get(/databases/$(database)/documents/config/app).data.picksLocked == true);
    }

    function leaderboardLocked() {
      return get(/databases/$(database)/documents/config/app).data.leaderboardLocked == true;
    }

    // Picks: public create/update with code+lastNameLower checks; reads allowed
    match /picks/{pickId} {
      allow get: if true;
      allow list: if true;

      allow create: if (submissionsOpen() || isAdmin())
        && request.resource.data.code is string
        && request.resource.data.code.matches('^[0-9]{6}$')
        && request.resource.data.year is number
        && request.resource.data.week is number
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.lastNameLower is string
        && request.resource.data.phone is string
        && request.resource.data.venmo is string
        && request.resource.data.venmoConfirmed is bool
        && request.resource.data.picks is map;

      allow update: if (submissionsOpen() || isAdmin())
        && request.resource.data.code == resource.data.code
        && request.resource.data.lastNameLower == resource.data.lastNameLower
        && request.resource.data.year == resource.data.year
        && request.resource.data.week == resource.data.week;

      // Real season picks are immutable once the leaderboard opens - no delete,
      // ever, even for admins, past that point. Before the leaderboard opens
      // (or for the year >= 2090 dummy/test sandbox), an admin can still
      // delete a mistaken/duplicate entry.
      allow delete: if isAdmin() && (
        (resource.data.year is number && resource.data.year >= 2090)
        || leaderboardLocked()
      );
    }

    // Keys: helper collection
    match /keys/{keyId} {
      allow get: if true;
      allow list: if true;
      allow create: if request.resource.data.picksId is string && request.resource.data.picksId.size() > 0;
      allow update: if resource.data.picksId == request.resource.data.picksId;
      allow delete: if false;
    }

    // Games & Results: public read; admin write
    match /games/{doc=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /results/{doc=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Config:
    // - cfbd: admin-only read/write (protects API key)
    // - others: public read; admin write
    match /config/cfbd {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /config/{doc=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admins: only the signed-in admin can read their own doc; no writes via client
    match /admins/{uid} {
      allow read: if isAdmin() && request.auth.uid == uid;
      allow write: if false;
    }

    // Public scoreboard: anyone can read; only admins can write
    match /public/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Push notification tokens: any device can register itself (doc id is the
    // token, so a device can only touch its own doc) and self-tag a display
    // name when it submits picks. Only a genuine admin can mark their own
    // token isAdmin:true (so admin-only alerts can't be self-granted). Only
    // admins can read the list (to manage recipients) or set `blocked`.
    match /pushTokens/{token} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if request.resource.data.token == token
        && (request.resource.data.get('isAdmin', false) != true || isAdmin());
      allow update: if isAdmin()
        || (request.resource.data.token == token
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name"]));
      allow delete: if true;
    }

    // Contact overrides: admin-entered emails for people whose picks docs
    // never captured one, keyed by the same name/Venmo identity used on the
    // "Who Hasn't Submitted" admin page. Admin-only.
    match /contacts/{key} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Unassigned emails: same idea as /contacts, but for people who aren't on
    // the roster yet at all (no picks doc to derive an identity key from) -
    // keyed by the email itself until an admin attaches a name.
    match /unassignedContacts/{key} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Notification outbox: admin drops a {title, body} doc here to broadcast
    // a push notification; a Cloud Function picks it up and deletes it.
    match /notificationOutbox/{id} {
      allow read: if false;
      allow create: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.body is string
        && (!('targetToken' in request.resource.data) || request.resource.data.targetToken is string);
      allow update: if false;
      allow delete: if false;
    }

    // Admin taps "Clean Up Devices Now" -> drops an empty trigger doc here;
    // a Cloud Function dry-runs every registered token and removes any FCM
    // reports as no longer valid, then deletes this doc.
    match /deviceCleanupRequests/{id} {
      allow read: if false;
      allow create: if isAdmin();
      allow update: if false;
      allow delete: if false;
    }
  }
}

