rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function submissionsOpen() {
      return !(get(/databases/$(database)/documents/config/app).data.picksLocked == true);
    }

    function leaderboardLocked() {
      return get(/databases/$(database)/documents/config/app).data.leaderboardLocked == true;
    }

    function chatDeviceOf(deviceId) {
      return get(/databases/$(database)/documents/chatDevices/$(deviceId)).data;
    }

    // A pick write must include a valid tiebreaker whenever it's for the
    // currently live year/week AND that week has a College GameDay game
    // assigned (config/live.gamedayGameId). Added after a client-side race
    // let three real submissions through with no tiebreaker at all - this
    // is the server-side backstop so no future client bug can do that
    // again. Admins are exempt so historical data can still be patched. A
    // partial-slate doc (see picks.partial) may omit it entirely for now -
    // GameDay itself may be one of the deferred games - but if one IS given
    // it still has to be well-formed.
    function tiebreakerValid(data) {
      let live = get(/databases/$(database)/documents/config/live).data;
      let gdId = live.get('gamedayGameId', null);
      let isLiveWeek = data.year == live.get('year', null) && data.week == live.get('week', null);
      let gdRequired = isLiveWeek && gdId is string && gdId.size() > 0;
      let tb = data.get('tiebreaker', null);
      return !gdRequired
        || (data.get('partial', false) == true && tb == null)
        || (tb is map && tb.get('gameId', null) == gdId && tb.get('total', null) is number);
    }

    // Picks: public create/update with code+lastNameLower checks; reads allowed
    match /picks/{pickId} {
      allow get: if true;
      allow list: if true;

      allow create: if (submissionsOpen() || isAdmin())
        && request.resource.data.code is string
        && request.resource.data.code.matches('^[0-9]{6}$')
        && request.resource.data.year is number
        && request.resource.data.week is number
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.lastNameLower is string
        && request.resource.data.phone is string
        && request.resource.data.venmo is string
        && request.resource.data.venmoConfirmed is bool
        && request.resource.data.picks is map
        && (isAdmin() || tiebreakerValid(request.resource.data));

      // Any submission for a week with later day(s) of games - partial or a
      // normal complete one - can still be edited after the pool-wide lock
      // trips, up until its own stored editDeadline (the earliest kickoff
      // among the later day's games). editDeadline is set once, at initial
      // submission, and carried forward unchanged after that - nothing here
      // re-validates its value against the schedule. (Separately, `partial`
      // gates whether the doc was allowed to leave those games unpicked in
      // the first place - see tiebreakerValid and isForfeitedPick client-side.)
      allow update: if (
        submissionsOpen()
        || isAdmin()
        || (resource.data.editDeadline is timestamp
            && request.time < resource.data.editDeadline)
      )
        && request.resource.data.code == resource.data.code
        && request.resource.data.lastNameLower == resource.data.lastNameLower
        && request.resource.data.year == resource.data.year
        && request.resource.data.week == resource.data.week
        && (isAdmin() || tiebreakerValid(request.resource.data));

      // Real season picks are immutable once the leaderboard opens - no delete,
      // ever, even for admins, past that point. Before the leaderboard opens
      // (or for the year >= 2090 dummy/test sandbox), an admin can still
      // delete a mistaken/duplicate entry.
      allow delete: if isAdmin() && (
        (resource.data.year is number && resource.data.year >= 2090)
        || leaderboardLocked()
      );
    }

    // Keys: helper collection
    match /keys/{keyId} {
      allow get: if true;
      allow list: if true;
      allow create: if request.resource.data.picksId is string && request.resource.data.picksId.size() > 0;
      allow update: if resource.data.picksId == request.resource.data.picksId;
      allow delete: if false;
    }

    // Games & Results: public read; admin write
    match /games/{doc=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /results/{doc=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Config:
    // - cfbd: admin-only read/write (protects API key)
    // - others: public read; admin write
    match /config/cfbd {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /config/{doc=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admins: only the signed-in admin can read their own doc; no writes via client
    match /admins/{uid} {
      allow read: if isAdmin() && request.auth.uid == uid;
      allow write: if false;
    }

    // Public scoreboard: anyone can read; only admins can write
    match /public/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Push notification tokens: any device can register itself (doc id is the
    // token, so a device can only touch its own doc), self-tag a display
    // name when it submits picks, and self-toggle chatNotifsEnabled (the
    // chat panel's opt-in "notify me when people chat" switch - deliberately
    // separate from the admin-controlled reminder toggles, which stay
    // opt-out by default). Only a genuine admin can mark their own token
    // isAdmin:true (so admin-only alerts can't be self-granted). A device
    // can read back its own doc (get) - needed so the chat panel can show
    // whether *this* device's toggle is on - but the token itself is an
    // effectively-unguessable ~150-char string, so this doesn't expose
    // anyone else's; only admins can list the whole collection or set
    // `blocked`.
    match /pushTokens/{token} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if request.resource.data.token == token
        && (request.resource.data.get('isAdmin', false) != true || isAdmin());
      allow update: if isAdmin()
        || (request.resource.data.token == token
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "chatNotifsEnabled"]));
      allow delete: if true;
    }

    // Contact overrides: admin-entered emails for people whose picks docs
    // never captured one, keyed by the same name/Venmo identity used on the
    // "Who Hasn't Submitted" admin page. Admin-only.
    match /contacts/{key} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Unassigned emails: same idea as /contacts, but for people who aren't on
    // the roster yet at all (no picks doc to derive an identity key from) -
    // keyed by the email itself until an admin attaches a name.
    match /unassignedContacts/{key} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Players: the persistent, admin-editable roster (Player Profiles page) -
    // supersedes /contacts and /unassignedContacts above (kept in place as
    // inert leftovers post-migration, not read/written by current app code).
    // Auto-generated doc id; aliasKeys ties it to picks docs, see buildRoster
    // in web/src/App.jsx. Public read (matching /picks below, the same
    // category of contact info) so a Player Profiles rename/merge/opt-out is
    // reflected on public pages too - My Season, Overall Leaderboard, chat -
    // not just admin-only ones. Write stays admin-only.
    match /players/{playerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Notification outbox: admin drops a {title, body} doc here to broadcast
    // a push notification; a Cloud Function picks it up and deletes it.
    match /notificationOutbox/{id} {
      allow read: if false;
      allow create: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.body is string
        && (!('targetToken' in request.resource.data) || request.resource.data.targetToken is string);
      allow update: if false;
      allow delete: if false;
    }

    // Weekly polls: anyone can vote or change their own vote (doc id embeds
    // their local voter id, one doc per poll per voter); tallies are
    // admin-only for now, not shown to voters.
    match /pollVotes/{voteId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if request.resource.data.pollId is string
        && (request.resource.data.get('choice', '') is string)
        && (request.resource.data.get('choices', []) is list);
      allow update: if request.resource.data.pollId == resource.data.pollId;
      allow delete: if false;
    }

    // Optional free-text suggestions from the Picks page (not required to
    // submit picks). One doc per voter id, same idea as pollVotes; admin-only
    // reads for now.
    match /feedback/{voteId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if request.resource.data.text is string && request.resource.data.text.size() > 0;
      allow update: if request.resource.data.text is string && request.resource.data.text.size() > 0;
      allow delete: if false;
    }

    // Weekly chat: a device claims a display name once (doc id is either the
    // device's push-notification token, reused so a device already known by
    // name never has to ask again, or a random locally-generated id). Once
    // created a device can never rename itself - only an admin can, via
    // update/delete - so no device can later post messages under a different
    // name than the one it started with. The `verified` flag (client-set,
    // true only when the chooser's typed email matched that person's known
    // picks-history email) is purely informational for the "verified" badge;
    // it is not itself enforced server-side, matching the low-friction bar
    // requested for this feature. `blocked` (admin-set) IS enforced - see
    // the chatMessages create rule below, which rejects new messages from a
    // blocked device while leaving its name and past messages untouched.
    match /chatDevices/{deviceId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 60;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Chat: one continuous thread, not scoped per week - {threadKey} is
    // always the fixed CHAT_THREAD_KEY value ("general", kept in sync
    // between web/src/App.jsx and functions/index.js), just still nested a
    // level down so reads/writes never need a composite index. A message's
    // `name` must equal the poster's own locked chatDevices name, so nobody
    // can spoof a different display name than the one their device is stuck
    // with, and a blocked device is rejected outright.
    match /chatMessages/{threadKey}/messages/{msgId} {
      allow get: if true;
      allow list: if true;
      // A message needs either non-empty text or a photo (imageUrl) - one
      // can carry both (a caption on a photo) or just one. imageUrl must
      // point at our own Storage bucket, not an arbitrary external URL, so
      // there's no way to bypass the upload flow's size/type limits.
      allow create: if request.resource.data.deviceId is string
        && request.resource.data.name is string
        && request.resource.data.get('text', '') is string
        && request.resource.data.get('text', '').size() <= 500
        && (
          request.resource.data.get('text', '').size() > 0
          || (request.resource.data.get('imageUrl', null) is string
              && request.resource.data.imageUrl.matches('https://firebasestorage\\.googleapis\\.com/.*'))
        )
        && (
          isAdmin()
          || (request.resource.data.name == chatDeviceOf(request.resource.data.deviceId).name
              && chatDeviceOf(request.resource.data.deviceId).get('blocked', false) != true)
        );
      // Reactions are the one thing a client can update after the fact - a
      // message's text/name/deviceId stay immutable once posted (create-only
      // per above), but anyone can toggle an emoji on any message. Not
      // scoped to "only your own name" (that would need per-entry diffing
      // rules can't easily express) - matches the same low-friction trust
      // bar the rest of chat uses.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(["reactions"])
        && request.resource.data.reactions is map;
      allow delete: if isAdmin();
    }

    // Admin taps "Clean Up Devices Now" -> drops an empty trigger doc here;
    // a Cloud Function dry-runs every registered token and removes any FCM
    // reports as no longer valid, then deletes this doc.
    match /deviceCleanupRequests/{id} {
      allow read: if false;
      allow create: if isAdmin();
      allow update: if false;
      allow delete: if false;
    }
  }
}

